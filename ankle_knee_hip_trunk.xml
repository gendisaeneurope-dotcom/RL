<mujoco model="4dof_postural_control">
  <compiler angle="radian" inertiafromgeom="true"/>
  <default>
    <joint armature="0.05" damping="10" stiffness="20" limited="true"/>
    <geom contype="0" friction="1 0.1 0.1" rgba="0.7 0.7 0 1"/>
  </default>
  <option gravity="0 0 -9.81" integrator="implicitfast" timestep="0.005"/>


  <worldbody>
    <geom name="floor" type="plane" pos="0 0 0" size="5 5 0.1" rgba="0.9 0.9 0.9 1"/>


    <!-- Foot (fixed base, represents ankle pivot point) -->
    <body name="foot" pos="0 0 0.05">
      <geom name="foot_geom" type="box" size="0.15 0.05 0.05" rgba="0.3 0.3 0.3 1"/>


      <!-- Shank (lower leg) - rotates at ankle -->
      <body name="shank" pos="0 0 0.05">
        <joint name="ankle" type="hinge" axis="0 1 0" pos="0 0 0" range="-0.5 0.5"/>
        <geom name="shank_geom" type="capsule" fromto="0 0 0 0 0 0.45" size="0.03" rgba="0.8 0.2 0.2 1"/>
        <inertial pos="0 0 0.225" mass="4.0" diaginertia="0.05 0.05 0.01"/>


        <!-- Thigh (upper leg) - rotates at knee -->
        <body name="thigh" pos="0 0 0.45">
          <joint name="knee" type="hinge" axis="0 1 0" pos="0 0 0" range="-0.5 0.5"/>
          <geom name="thigh_geom" type="capsule" fromto="0 0 0 0 0 0.45" size="0.04" rgba="0.2 0.8 0.2 1"/>
          <inertial pos="0 0 0.225" mass="7.0" diaginertia="0.08 0.08 0.02"/>


          <!-- Pelvis/lower trunk - rotates at hip -->
          <body name="pelvis" pos="0 0 0.45">
            <joint name="hip" type="hinge" axis="0 1 0" pos="0 0 0" range="-0.5 0.5" damping="20"/>
            <geom name="pelvis_geom" type="capsule" fromto="0 0 0 0 0 0.2" size="0.06" rgba="0.2 0.2 0.8 1"/>
            <inertial pos="0 0 0.1" mass="12.0" diaginertia="0.1 0.1 0.02"/>


            <!-- Upper trunk - rotates at trunk/lumbar joint -->
            <body name="trunk" pos="0 0 0.2">
              <joint name="trunk" type="hinge" axis="0 1 0" pos="0 0 0" range="-0.4 0.4"/>
              <geom name="trunk_geom" type="capsule" fromto="0 0 0 0 0 0.4" size="0.06" rgba="0.6 0.2 0.6 1"/>
              <inertial pos="0 0 0.2" mass="23.0" diaginertia="0.25 0.25 0.04"/>
            </body>


          </body>
        </body>
      </body>
    </body>
  </worldbody>


  <actuator>
    <motor name="ankle_motor" joint="ankle" gear="50" ctrlrange="-1 1"/>
    <motor name="knee_motor" joint="knee" gear="50" ctrlrange="-1 1"/>
    <motor name="hip_motor" joint="hip" gear="75" ctrlrange="-1 1"/>
    <motor name="trunk_motor" joint="trunk" gear="40" ctrlrange="-1 1"/>
  </actuator>


</mujoco>